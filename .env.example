# 이 파일을 .env 로 복사한 뒤 실제 값을 채우세요. .env는 절대 커밋하지 마세요.

# Telegram Bot (필수)
# 1) Telegram에서 @BotFather 검색 -> /newbot -> 안내에 따라 봇 생성 -> 토큰 발급
# 2) 생성된 봇과 대화 시작(아무 메시지나 전송) 후,
#    https://api.telegram.org/bot<TOKEN>/getUpdates 를 브라우저로 열어
#    "chat":{"id": ...} 값을 확인 -> TELEGRAM_CHAT_ID에 입력
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# X(Twitter) API v2 Bearer Token (선택, 유료 Basic tier 이상 필요)
# 미설정 시 twitter 수집은 자동으로 건너뜁니다.
X_BEARER_TOKEN=
